{
  "name": "@hkfires/pi-review",
  "version": "0.1.18",
  "description": "A standalone code review extension for Pi with /review and /end-review, forked from diegopetrucci/pi-extensions.",
  "keywords": [
    "pi-package",
    "pi",
    "review",
    "code-review",
    "git",
    "github"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hkfires/pi-review.git"
  },
  "files": [
    "index.ts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/host-review.test.ts"
  },
  "publishConfig": {
    "access": "public"
  },
  "pi": {
    "extensions": [
      "index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": ">=0.86.0",
    "@earendil-works/pi-coding-agent": ">=0.86.0",
    "@earendil-works/pi-tui": ">=0.86.0"
  },
  "dependencies": {
    "proper-lockfile": "^4.1.2",
    "semver": "^7.7.0"
  },
  "devDependencies": {
    "@types/proper-lockfile": "^4.1.4",
    "@types/semver": "^7.7.1"
  },
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  }
}
